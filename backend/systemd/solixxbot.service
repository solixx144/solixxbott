[Unit]
Description=SolixxBot Telegram Announcement & Moderation Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/solixxbot/backend
EnvironmentFile=/opt/solixxbot/backend/.env
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
