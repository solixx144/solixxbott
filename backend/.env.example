# SolixxBot Backend Configuration
# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Target Channel (The bot MUST be an administrator in this channel with post permissions)
TARGET_CHANNEL=@SolixxTR

# 3. Administrator Secret API Key (Used by the Android app to authenticate administrative requests)
ADMIN_API_KEY=your_admin_secret_api_key_here

# 4. Administrator Numeric Telegram User ID (Required: strictly identifies the administrator)
ADMIN_TELEGRAM_ID=

# 5. Server Host & Port
HOST=0.0.0.0
PORT=8000

# 6. SQLite Database Path
DATABASE_PATH=solixxbot.db
